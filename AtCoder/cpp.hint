// ヒント ファイルは、Visual Studio IDE が Visual C++ 識別子を解釈するのに役立ちます
// 関数およびマクロの名前などです。
// 詳細については次を参照してください https://go.microsoft.com/fwlink/?linkid=865984
#define sz(x) ((int)(x).size())
#define repi(i, s, t) for(int i = int(s), i##_end = int(t); i <= i##_end; ++i)
// ヒント ファイルは、Visual Studio IDE が Visual C++ 識別子を解釈するのに役立ちます
// 関数およびマクロの名前などです。
// 詳細については次を参照してください https://go.microsoft.com/fwlink/?linkid=865984
#define uniq(a) {sort(all(a)); (a).erase(unique(all(a)), (a).end());}
#define rep(i, n) for(int i = 0, i##_len = int(n); i < i##_len; ++i)
#define dumpel(a) { int _i_ = -1; cout << "\033[1;36m"; repe(x, a) {cout << ++_i_ << ": " << x << endl;} cout << "\033[0m"; }
#define dumpel(v)
